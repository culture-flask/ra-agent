# 数据库连接串（开发环境）
DATABASE_URL=postgresql+psycopg://ra:ra@localhost:5432/ra_agent
# Redis
REDIS_URL=redis://localhost:6379/0
# LLM 系统级密钥（开发/测试）
LLM_API_KEY=""
# 嵌入模型云端密钥
EMBEDDING_API_KEY=""
# 网络代理（环境相关：SSH 会话等无代理环境必须配置，否则外部 API 直连被网络黑洞）
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1