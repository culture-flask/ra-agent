# 数据库连接串（开发环境）
DATABASE_URL=postgresql+psycopg://ra:ra@localhost:5432/ra_agent
# Redis
REDIS_URL=redis://localhost:6379/0
# LLM 系统级密钥（开发/测试）
LLM_API_KEY=""
# 嵌入模型云端密钥
EMBEDDING_API_KEY=""
# 网络代理（环境相关：SSH 会话等无代理环境必须配置，否则外部 API 直连被网络黑洞）
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1

# ---- MCP 学术检索工具（servers/research_server.py，均可选，不配也能用）----
# Semantic Scholar 专属 API key（免费申请：https://www.semanticscholar.org/product/api）
# 不配则用免费共享额度，高峰期易 429（此时工具会引导 LLM 改用 openalex_search）
S2_API_KEY=""
# OpenAlex 礼貌池邮箱（提供后进入更稳定的访问池，仅用于联系用途）
OPENALEX_MAILTO=""